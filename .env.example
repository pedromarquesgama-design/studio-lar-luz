# ==========================================
# STUDIO LAR & LUZ - CONFIGURAÇÃO DE AMBIENTE
# ==========================================

# Informações Gerais da Loja
NEXT_PUBLIC_STORE_NAME="Studio Lar & Luz"
NEXT_PUBLIC_STORE_URL="http://localhost:3000"
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=199
NEXT_PUBLIC_PIX_DISCOUNT_PERCENT=5

# Modo de Commerce Provider ("mock" ou "shopify")
# Quando "mock", roda com o catálogo brasileiro rico integrado sem requisições externas.
# Quando "shopify", conecta diretamente à Storefront API e Admin API da sua loja Shopify.
COMMERCE_PROVIDER=mock

# Shopify Headless Storefront & Admin API
# Obtenha em: Shopify Admin -> Settings -> Apps and sales channels -> Develop apps
SHOPIFY_STORE_DOMAIN="studio-lar-luz.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_ADMIN_API_TOKEN=""
SHOPIFY_API_VERSION="2024-10"

# Stripe (Pix, Cartões e Carteiras Digitais no Brasil)
# Obtenha em: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# AliExpress & DSers Dropshipping Sync
# Obtenha no portal AliExpress Open Platform ou App DSers
ALIEXPRESS_APP_KEY=""
ALIEXPRESS_APP_SECRET=""
ALIEXPRESS_ACCESS_TOKEN=""
DSERS_API_TOKEN=""

# Margens e Regras de Preço para Importação
ALIEXPRESS_MARKUP_MULTIPLIER=2.8
ALIEXPRESS_SHIPPING_BUFFER_BRL=18.50
ALIEXPRESS_USD_BRL_RATE=5.70
REMESSA_CONFORME_TAX_PERCENT=20.0
